# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
DATABASE_URL=

# Survey model routing (explicit model variants only; aliases are rejected).
AI_MODEL_SURVEY_MEDIUM=gpt-5.6-terra
AI_REASONING_SURVEY_MEDIUM=medium
AI_MODEL_SURVEY_HIGH=gpt-5.6-sol
AI_REASONING_SURVEY_HIGH=high
AI_MODEL_SIMPLE_EDIT=gpt-5.6-luna
AI_REASONING_SIMPLE_EDIT=low
AI_MODEL_RESULT_ANALYSIS=gpt-5.6-terra
AI_REASONING_RESULT_ANALYSIS=medium

# Cost and safety controls.
OPENAI_SERVICE_TIER=default
ALLOW_OPENAI_FAST_TIER=false
ALLOW_SOL_FALLBACK=false
AI_MOCK_MODE=false
RUN_REAL_AI_TESTS=false
ALLOW_REAL_OPENAI_IN_NON_PRODUCTION=false
MAX_REAL_AI_TEST_CALLS=3

# Application rate limits and server-only signing secret.
BAROFORM_AI_MAX_PER_HOUR=8
BAROFORM_REFERENCE_SECRET=
